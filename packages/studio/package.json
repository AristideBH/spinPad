{
  "name": "@spinpad/studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:embedded": "cross-env VITE_TRANSPORT=http VITE_BUILD_DIR=build-embedded vite build --outDir build-embedded",
