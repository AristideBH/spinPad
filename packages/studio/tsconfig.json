{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "moduleResolution": "bundler",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "paths": {
            "lib/*": [
                "./src/lib/*"
            ],
            "components/*": [
                "./src/lib/components/*"
            ],
            "utils/*": [
                "./src/lib/utils/*"
            ],
            "ui/*": [
                "./src/lib/components/ui/*"
            ],
            "hooks/*": [
                "./src/lib/hooks/*"
            ],
        }
    },
}