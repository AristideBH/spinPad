# ──────────────────────────────────────────
#  config-app (SvelteKit) — .gitignore
# ──────────────────────────────────────────

# ── SvelteKit ─────────────────────────────
.svelte-kit/        # generated by svelte-kit sync / vite dev
build/              # static build output (adapter-static)

# ── Node ──────────────────────────────────
node_modules/

# ── Environment ───────────────────────────
# !! NEVER commit — local secrets
.env
# .env.example is committed intentionally (no secrets)

# ── TypeScript ────────────────────────────
*.tsbuildinfo

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db
