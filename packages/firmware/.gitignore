# ──────────────────────────────────────────
#  firmware/ (ESP-IDF) — .gitignore
# ──────────────────────────────────────────

# ── Build ESP-IDF ─────────────────────────
build/              # CMake artifacts + compiled binaries

# ── Config menuconfig ─────────────────────
sdkconfig           # generated by idf.py menuconfig, machine-specific
                    # sdkconfig.defaults is committed (base values)

# ── Managed dependencies ──────────────────
dependencies.lock
managed_components/ # components downloaded via idf_component_manager

# ── Editors / toolchain ──────────────────
.ccls-cache/
compile_commands.json
