# ─────────────────────────────────────────────────
#  sdkconfig.defaults — SpinPad (values common to all boards)
#  These values are applied on the first build.
#
#  NOTE : CONFIG_IDF_TARGET is NOT defined here.
#  It must be specified by the sdkconfig file specific to each board :
#    hardware/boards/<board>/sdkconfig.board
#  Usage example :
#    idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;../../hardware/boards/spinpad-v1/sdkconfig.board" build
#
#  This allows supporting spinpad-v2 (or another ESP) without modifying this file.
# ─────────────────────────────────────────────────

# ── USB ──────────────────────────────────────────
# Enable USB OTG mode (required for USB HID via TinyUSB)
CONFIG_USB_OTG_SUPPORTED=y
# TinyUSB as the USB stack
# CONFIG_BOARD_TINYUSB=y
# CONFIG_BOARD_TINYUSB_HID_ENABLED=y
# HID descriptor buffer
# CONFIG_BOARD_TINYUSB_HID_BUFSIZE=64

# ── Bluetooth ────────────────────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# HID over GATT Profile (HOG)
CONFIG_BT_NIMBLE_HID_SERVICE=y
# 2 simultaneous connections max (we use 1 at a time but NimBLE needs the config)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Store the bonds in NVS (persistence after reboot)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Number of stored bonds (one per BLE slot)
CONFIG_BT_NIMBLE_MAX_BONDS=2

# ── NVS (config storage in flash) ───────────────
CONFIG_NVS_ENCRYPTION=n

# ── Logs ─────────────────────────────────────────
# In development : INFO. In production : WARNING
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Deep sleep ───────────────────────────────────
# Enable wakeup via GPIO (keyboard keys)
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=y

# ── NVS partition size ───────────────────
# 20KB are largely enough for the configs
CONFIG_NVS_PAGE_SIZE=4096

# ── FreeRTOS ─────────────────────────────────────
# Tick rate at 1000Hz for better timer precision (combos, tap-hold)
CONFIG_FREERTOS_HZ=1000

# ── Flash size (ESP32-S3, 8MB) ──────────────────────────
# Must be defined explicitly : otherwise ESP-IDF falls back to 2MB by default,
# which is inconsistent with the partition table (app 3MB + SPIFFS beyond
# 0x400000) and prevents booting.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# ── Partition table ──────────────────────────────────────
# Custom partition : NVS + app 3MB + SPIFFS 1.5MB for Studio Mode
# (~3.4MB of flash reserved at the end for a future OTA slot)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../hardware/boards/spinpad-v1/partitions.csv"

# ── WiFi (Studio Mode) ───────────────────────────────────────
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Max TX power limited : WiFi TX ≤ 10dBm when VSYS > 4.5V (PCB constraint)
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=40

# ── HTTP Server ──────────────────────────────────────────────
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# ── SPIFFS ───────────────────────────────────────────────────
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_WR=y
CONFIG_SPIFFS_PAGE_SIZE=256
CONFIG_SPIFFS_MAX_PARTITIONS=3
