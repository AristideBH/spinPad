# ─────────────────────────────────────────────────
#  sdkconfig.defaults — SpinPad (valeurs communes à toutes les boards)
#  Ces valeurs sont appliquées lors du premier build.
#
#  NOTE : CONFIG_IDF_TARGET n'est PAS défini ici.
#  Il doit être spécifié par le fichier sdkconfig propre à chaque board :
#    hardware/boards/<board>/sdkconfig.board
#  Exemple d'utilisation :
#    idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;../../hardware/boards/spinpad-v1/sdkconfig.board" build
#
#  Cela permet de supporter spinpad-v2 (ou un autre ESP) sans modifier ce fichier.
# ─────────────────────────────────────────────────

# ── USB ──────────────────────────────────────────
# Active le mode USB OTG (nécessaire pour USB HID via TinyUSB)
CONFIG_USB_OTG_SUPPORTED=y
# TinyUSB comme stack USB
# CONFIG_BOARD_TINYUSB=y
# CONFIG_BOARD_TINYUSB_HID_ENABLED=y
# Buffer de descripteur HID
# CONFIG_BOARD_TINYUSB_HID_BUFSIZE=64

# ── Bluetooth ────────────────────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# HID over GATT Profile (HOG)
CONFIG_BT_NIMBLE_HID_SERVICE=y
# 2 connexions simultanées max (on en utilise 1 à la fois mais NimBLE a besoin de la config)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Stocker les bonds en NVS (persistance après reboot)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Nombre de bonds stockés (un par slot BLE)
CONFIG_BT_NIMBLE_MAX_BONDS=2

# ── NVS (stockage config en flash) ───────────────
CONFIG_NVS_ENCRYPTION=n

# ── Logs ─────────────────────────────────────────
# En développement : INFO. En production : WARNING
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Deep sleep ───────────────────────────────────
# Active le wakeup par GPIO (touches du clavier)
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=y

# ── Taille de la partition NVS ───────────────────
# 20KB suffisent largement pour les configs
CONFIG_NVS_PAGE_SIZE=4096

# ── FreeRTOS ─────────────────────────────────────
# Tick rate à 1000Hz pour une meilleure précision des timers (combos, tap-hold)
CONFIG_FREERTOS_HZ=1000

# ── Table de partitions ──────────────────────────────────────
# Partition custom : NVS + app 3MB + SPIFFS 960KB pour Studio Mode
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../hardware/boards/spinpad-v1/partitions.csv"

# ── WiFi (Studio Mode) ───────────────────────────────────────
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Puissance TX max limitée : WiFi TX ≤ 10dBm quand VSYS > 4.5V (contrainte PCB)
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=40

# ── HTTP Server ──────────────────────────────────────────────
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# ── SPIFFS ───────────────────────────────────────────────────
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_WR=y
CONFIG_SPIFFS_PAGE_SIZE=256
CONFIG_SPIFFS_MAX_PARTITIONS=3
