{
  "folders": [
    {
      "path": "packages/firmware",
      "name": "💽 Firmware"
    },
    {
      "path": "packages/studio",
      "name": "🖌️ Studio"
    },
    {
      "path": "packages/shared",
      "name": "📦 Shared"
    },
    {
      "path": "packages/website",
      "name": "🌐 Website"
    },
    {
      "path": ".",
      "name": "♾️ Root"
    }
  ],
  "settings": {
    "idf.idfContainerPath": "${workspaceFolder:🔧 Firmware}",
    "cmake.sourceDirectory": "${workspaceFolder:🔧 Firmware}",
    "files.exclude": {
      "**/node_modules": true,
      "**/.svelte-kit": true,
      "**/build": false
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/build": true,
      "**/.svelte-kit": true,
      "**/managed_components": true
    },
    "[c]": {
      "editor.defaultFormatter": "ms-vscode.cpp-devtools"
    },
    "[svelte]": {
      "editor.defaultFormatter": "svelte.svelte-vscode"
    },
    "hide-files.files": []
  },
  "extensions": {
    "recommendations": [
      "espressif.esp-idf-extension",
      "svelte.svelte-vscode",
      "bradlc.vscode-tailwindcss",
      "dbaeumer.vscode-eslint"
    ]
  }
}