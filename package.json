{
  "name": "spinpad",
  "version": "0.0.0",
  "private": true,
  "description": "SpinPad — custom macropad monorepo (firmware + studio + shared)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spinpad/website dev",
    "dev:studio": "pnpm --filter @spinpad/studio dev",
    "build:studio": "pnpm --filter @spinpad/studio build",
    "build:embedded": "pnpm --filter @spinpad/studio build:embedded",
    "codegen": "pnpm --filter @spinpad/shared codegen",
    "check:studio": "pnpm --filter @spinpad/studio check",
    "check:shared": "pnpm --filter @spinpad/shared check",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "changeset version && git add -A"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "eslint-plugin-svelte": "^3.18.0",
    "fallow": "^2.95.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1"
  },
  "dependencies": {
    "bits-ui": "^2.18.1"
  }
}
